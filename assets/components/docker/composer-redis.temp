redis:
  image: redis:7-alpine
  container_name: redis-cache
  restart: unless-stopped
  ports:
    - "${REDIS_PORT}:${REDIS_PORT}"
  volumes:
    - redis-data:/data
  command: redis-server --requirepass ${REDIS_PASSWORD}
  healthcheck:
    test: [ "CMD", "redis-cli", "ping" ]
    interval: 10s
    timeout: 5s
    retries: 5
  networks:
    - app-network
