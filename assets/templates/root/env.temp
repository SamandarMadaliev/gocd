# Application
APP=my-app
ENVIRONMENT=local
LOG_LEVEL=DEBUG
CONTEXT_TIMEOUT=30s


# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=120s


# JWT Auth
JWT_ACCESS_SECRET=secret
JWT_REFRESH_SECRET=supersecret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=24h


# Database
DATABASE_USERNAME=user
DATABASE_PASSWORD=password
DATABASE_NAME=database
DATABASE_PORT=5432


# Redis
REDIS_PORT=6379
REDIS_PASSWORD=password