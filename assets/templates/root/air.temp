root = "."
tmp_dir = "tmp"

[build]
  # Just call `make` command
  cmd = "go build -o ./tmp/main ."
  # Binary file to run
  bin = "tmp/main"
  # Customize delay
  delay = 1000
  # Files to watch
  include_ext = ["go", "tpl", "tmpl", "html"]
  # Exclude files/directories
  exclude_dir = ["assets", "tmp", "vendor", "testdata"]
  # Include specific directories
  include_dir = []
  # Exclude files
  exclude_file = []
  # Logs
  log = "air.log"

[log]
  # Show logs
  time = true

[color]
  # Customize color scheme
  main = "magenta"
  watcher = "cyan"
  build = "yellow"
  runner = "green"

[misc]
  # Delete tmp directory on exit
  clean_on_exit = true