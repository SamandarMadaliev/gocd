package postgres

import (
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"{{ .ModuleName }}/internal/inerr"
)

func ErrSQLBuild(err error, message string) error {
	return fmt.Errorf("error during sql build, %s: %w", message, err)
}

func Error(err error, item string) error {
	var pgErr *pgconn.PgError
	if errors.As(err, &pgErr) {
		switch pgErr.Code {
		case "23505":
			return inerr.NewErrConflict(item)
		}
	}
	if err == pgx.ErrNoRows {
		return inerr.NewErrNotFound(item)
	}

	if err.Error() == "no rows affected" {
		return inerr.NewErrNoChanges(item)
	}

	return err
}
